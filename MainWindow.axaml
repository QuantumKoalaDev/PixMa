<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:views="clr-namespace:PixelPaintApp.View"
		xmlns:viewmodels="clr-namespace:PixelPaintApp.Viewmodel"
        xmlns:local="clr-namespace:PixelPaintApp"
        x:Class="PixelPaintApp.MainWindow"
        Title="PixelPaint"
        Width="800" Height="600"
        SystemDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
		x:DataType="viewmodels:PixelCanvasViewModel"
        >
    
    <Window.Styles>
        <Style Selector="Button">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="Black" />
            <Setter Property="BorderBrush" Value="Black" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="5" />
            
        </Style>
        
        <!-- Titelbuttons (z. B. "Vor", "Zurück") -->
        <Style Selector="Button.title-button">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="#8c8b8b"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="5,0"/>
        </Style>

        <!-- Fenstersteuerungsbuttons (—, □, ✕) -->
        <Style Selector="Button.window-button">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="#8c8b8b"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        
        <Style Selector="Button.brush-size">
            <Setter Property="Height" Value="30" />
            <Setter Property="Width" Value="30" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.3"/>
                </Transitions>
            </Setter>
        </Style>
        
        

    </Window.Styles>
    
    <Window.Resources>
        <Color x:Key="MainColor">#ffd700</Color>
        
        <SolidColorBrush x:Key="MainColorBrush" Color="{StaticResource MainColor}"></SolidColorBrush>
    </Window.Resources>

    
    <Border Background="#8c8b8b">
    <Grid>
        <!-- === Layout-Struktur === -->
        <Grid.RowDefinitions>
            <RowDefinition Height="35"/>  <!-- Titelzeile -->
            <RowDefinition Height="*"/>   <!-- Inhalt -->
        </Grid.RowDefinitions>

        <!-- === TITELLEISTE === -->
        <DockPanel Grid.Row="0"
                   Background="#8c8b8b"
                   Height="35"
                   PointerPressed="TitleBar_OnPointerPressed">

            <!-- Menü -->
            <Menu DockPanel.Dock="Left">
                <MenuItem Header="_Datei">
                    <MenuItem Header="Speichern" Click="Save_Click" />
                    <MenuItem Header="Öffnen..." />
                    <!--<MenuItem Header="Speichern" Command="{Binding SaveCommand}" />-->
                    <MenuItem Header="Beenden" />
                </MenuItem>
            </Menu>

            <!-- Navigationsbuttons -->
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <Button Classes="title-button" Content="Vor"/>
                <Button Classes="title-button" Content="Zurück"/>
            </StackPanel>

            <!-- Fenstersteuerung -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        DockPanel.Dock="Right">
                <Button Classes="window-button" Content="—" Click="Minimize_Click"/>
                <Button Classes="window-button" Content="□" Click="Maximize_Click"/>
                <Button Classes="window-button" Content="✕" Click="Close_Click"/>
            </StackPanel>
        </DockPanel>

        <!-- === HAUPTBEREICH === -->
        <Grid Grid.Row="1" Background="{StaticResource MainColorBrush}">

            <!-- Unsichtbare Resize-Zonen -->
            <Border HorizontalAlignment="Right" Width="10"
                    Background="Transparent"
                    Cursor="SizeWestEast"
                    PointerPressed="Resize_Right"/>
            <Border HorizontalAlignment="Left" Width="10"
                    Background="Transparent"
                    Cursor="SizeWestEast"
                    PointerPressed="Resize_Left"/>
            <Border VerticalAlignment="Bottom" Height="10"
                    Background="Transparent"
                    Cursor="SizeNorthSouth"
                    PointerPressed="Resize_Bottom"/>

            <!-- Inhaltsbereich -->
            <DockPanel Margin="5">
                <!-- Farbpalette -->
                <StackPanel Orientation="Vertical"
                            DockPanel.Dock="Left"
                            Margin="0,0,10,0">
                    <Button Background="Black" Width="30" Height="30" Click="Black_Click"/>
                    <Button Background="Red" Width="30" Height="30" Click="Red_Click"/>
                    <Button Background="Green" Width="30" Height="30" Click="Green_Click"/>
                    <Button Background="Blue" Width="30" Height="30" Click="Blue_Click"/>
                    
                    <!-- Button zum öffnen der Farbcodeeingabe -->
                    <Button Width="30" Height="30" Margin="5, 20, 5, 5" />
                    
                    <!-- Pinsel stärke auswählen -->
                    <Button Content="1" Classes="brush-size" Margin="5, 20, 5, 5" Click="PixelSize1_Click" />
                    <Button Content="4" Classes="brush-size" Click="PixelSize4_Click"/>
                    <Button Content="9" Classes="brush-size" Click="PixelSize9_Click"/>
                </StackPanel>

                <!-- Werkzeugleiste + Canvas -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="50"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal"
                                Background="{StaticResource MainColorBrush}"
                                Grid.Row="0"
                                Margin="0,0,0,5"
                                >
                        <Button Content="Pinsel" />
                        <Button Content="Radierer" />
						<CheckBox Content="Grid Lines" IsChecked="True" Checked="ToggleGridLines_Click" Unchecked="ToggleGridLines_Click" />
						<Button Content="Save file" Click="Save_Click" />
                    </StackPanel>

                    <views:PixelCanvas x:Name="MyCanvas"
                                       Grid.Row="1"
                                       Pixel="10"
									   />
                </Grid>
            </DockPanel>
        </Grid>
    </Grid>
</Border>

</Window>